# Backend
APP_ENV=local
FRONTEND_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_DATA_PATH=data/internships.json
DISCOVERY_USER_AGENT=InternshipIntelligenceBot/2.0
REQUEST_TIMEOUT_SECONDS=20
PROVIDER_CONCURRENCY=2
PROVIDER_CACHE_SECONDS=3600
PROVIDER_REQUEST_INTERVAL=1
DISCOVERY_COOLDOWN_SECONDS=60
STALE_DAYS=30
INACTIVE_DAYS=90
MINIMUM_TRUST=40
API_TOKEN=
ENABLE_AI_CLASSIFICATION=false
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=
AI_MODEL=
AI_CONFIDENCE_THRESHOLD=0.8
AI_CACHE_SECONDS=604800
RESUME_MAX_BYTES=2000000
# Lists in backend .env must be JSON, e.g. GREENHOUSE_BOARDS=["stripe","figma"]

# Frontend: set these separately in frontend/.env.local
API_BASE_URL=http://127.0.0.1:8000
# API_TOKEN must match the backend; never prefix it with NEXT_PUBLIC_.
# ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
# For remote single-owner access, require HTTPS and set both:
# WORKSPACE_USER=owner
# WORKSPACE_PASSWORD=<strong unique password>
